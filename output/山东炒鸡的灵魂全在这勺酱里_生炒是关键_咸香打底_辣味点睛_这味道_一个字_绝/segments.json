[
  {
    "start": "00:00:00.000",
    "end": "00:00:03.640",
    "start_sec": 0.0,
    "end_sec": 3.64,
    "text": "快过年了 给大家做一款山东炒鸡"
  },
  {
    "start": "00:00:07.160",
    "end": "00:00:10.200",
    "start_sec": 7.16,
    "end_sec": 10.200000000000001,
    "text": "小王师傅从事这行业也将近20年了"
  },
  {
    "start": "00:00:10.520",
    "end": "00:00:13.240",
    "start_sec": 10.52,
    "end_sec": 13.24,
    "text": "而且这20年一直做炒鸡"
  },
  {
    "start": "00:00:13.600",
    "end": "00:00:14.600",
    "start_sec": 13.6,
    "end_sec": 14.6,
    "text": "山东哪了"
  },
  {
    "start": "00:00:14.600",
    "end": "00:00:15.240",
    "start_sec": 14.6,
    "end_sec": 15.24,
    "text": "太安人"
  },
  {
    "start": "00:00:15.240",
    "end": "00:00:15.840",
    "start_sec": 15.24,
    "end_sec": 15.84,
    "text": "太安人"
  },
  {
    "start": "00:00:15.840",
    "end": "00:00:16.240",
    "start_sec": 15.84,
    "end_sec": 16.240000000000002,
    "text": "对"
  },
  {
    "start": "00:00:16.240",
    "end": "00:00:17.200",
    "start_sec": 16.240000000000002,
    "end_sec": 17.2,
    "text": "咱俩离得远吗"
  },
  {
    "start": "00:00:17.200",
    "end": "00:00:17.960",
    "start_sec": 17.2,
    "end_sec": 17.96,
    "text": "我福山"
  },
  {
    "start": "00:00:17.960",
    "end": "00:00:19.440",
    "start_sec": 17.96,
    "end_sec": 19.44,
    "text": "燕台"
  },
  {
    "start": "00:00:19.440",
    "end": "00:00:20.440",
    "start_sec": 19.44,
    "end_sec": 20.44,
    "text": "咱也算老乡了"
  },
  {
    "start": "00:00:20.440",
    "end": "00:00:21.080",
    "start_sec": 20.44,
    "end_sec": 21.080000000000002,
    "text": "对 老乡"
  },
  {
    "start": "00:00:21.080",
    "end": "00:00:22.120",
    "start_sec": 21.080000000000002,
    "end_sec": 22.12,
    "text": "所以说你就别紧张"
  },
  {
    "start": "00:00:22.120",
    "end": "00:00:22.480",
    "start_sec": 22.12,
    "end_sec": 22.48,
    "text": "你知道吗"
  },
  {
    "start": "00:00:22.480",
    "end": "00:00:23.000",
    "start_sec": 22.48,
    "end_sec": 23.0,
    "text": "好的"
  },
  {
    "start": "00:00:23.000",
    "end": "00:00:25.040",
    "start_sec": 23.0,
    "end_sec": 25.04,
    "text": "你应该紧张的是谁你知道吗"
  },
  {
    "start": "00:00:25.360",
    "end": "00:00:26.760",
    "start_sec": 25.36,
    "end_sec": 26.76,
    "text": "因为两个戴眼镜的紧张"
  },
  {
    "start": "00:00:27.120",
    "end": "00:00:29.560",
    "start_sec": 27.12,
    "end_sec": 29.560000000000002,
    "text": "这鸡是选用的小公鸡"
  },
  {
    "start": "00:00:29.560",
    "end": "00:00:31.000",
    "start_sec": 29.56,
    "end_sec": 31.0,
    "text": "是比较嫩的那种小公鸡"
  },
  {
    "start": "00:00:31.000",
    "end": "00:00:32.080",
    "start_sec": 31.0,
    "end_sec": 32.08,
    "text": "它一个是口感比较好"
  },
  {
    "start": "00:00:32.080",
    "end": "00:00:34.840",
    "start_sec": 32.08,
    "end_sec": 34.839999999999996,
    "text": "另一个是它成熟的时间也比较快"
  },
  {
    "start": "00:00:34.840",
    "end": "00:00:36.520",
    "start_sec": 34.839999999999996,
    "end_sec": 36.519999999999996,
    "text": "剩下的是一些香辛料"
  },
  {
    "start": "00:00:36.520",
    "end": "00:00:39.040",
    "start_sec": 36.519999999999996,
    "end_sec": 39.04,
    "text": "八椒 花椒 辣椒 白芷"
  },
  {
    "start": "00:00:39.040",
    "end": "00:00:39.840",
    "start_sec": 39.04,
    "end_sec": 39.839999999999996,
    "text": "家用足够了"
  },
  {
    "start": "00:00:39.840",
    "end": "00:00:40.600",
    "start_sec": 39.839999999999996,
    "end_sec": 40.6,
    "text": "如果商用的话"
  },
  {
    "start": "00:00:40.600",
    "end": "00:00:42.880",
    "start_sec": 40.6,
    "end_sec": 42.879999999999995,
    "text": "可能还有更多的一些会打成粉"
  },
  {
    "start": "00:00:42.880",
    "end": "00:00:44.360",
    "start_sec": 42.879999999999995,
    "end_sec": 44.36,
    "text": "咱们的新鲜食材"
  },
  {
    "start": "00:00:44.760",
    "end": "00:00:46.760",
    "start_sec": 44.76,
    "end_sec": 46.76,
    "text": "螺蛳椒 红尖椒"
  },
  {
    "start": "00:00:46.760",
    "end": "00:00:48.320",
    "start_sec": 46.76,
    "end_sec": 48.32,
    "text": "大蒜 生姜 大葱"
  },
  {
    "start": "00:00:48.320",
    "end": "00:00:49.120",
    "start_sec": 48.32,
    "end_sec": 49.12,
    "text": "这些就够了"
  },
  {
    "start": "00:00:49.720",
    "end": "00:00:51.160",
    "start_sec": 49.72,
    "end_sec": 51.16,
    "text": "剩下的是咱们的调料部分"
  },
  {
    "start": "00:00:51.160",
    "end": "00:00:52.400",
    "start_sec": 51.16,
    "end_sec": 52.4,
    "text": "黄豆酱是80克"
  },
  {
    "start": "00:00:52.880",
    "end": "00:00:54.040",
    "start_sec": 52.879999999999995,
    "end_sec": 54.04,
    "text": "蚝油20克"
  },
  {
    "start": "00:00:54.880",
    "end": "00:00:56.720",
    "start_sec": 54.879999999999995,
    "end_sec": 56.72,
    "text": "黄豆酱油40克"
  },
  {
    "start": "00:00:57.120",
    "end": "00:00:58.480",
    "start_sec": 57.120000000000005,
    "end_sec": 58.480000000000004,
    "text": "甜面酱40克"
  },
  {
    "start": "00:00:59.440",
    "end": "00:01:01.000",
    "start_sec": 59.44,
    "end_sec": 61.0,
    "text": "大家一定要注意"
  },
  {
    "start": "00:01:01.000",
    "end": "00:01:04.400",
    "start_sec": 61.0,
    "end_sec": 64.39999999999999,
    "text": "其实鸡的食材很重要"
  },
  {
    "start": "00:01:04.400",
    "end": "00:01:07.400",
    "start_sec": 64.39999999999999,
    "end_sec": 67.39999999999999,
    "text": "因为如果咱们要用那种有劲的鸡"
  },
  {
    "start": "00:01:07.400",
    "end": "00:01:09.200",
    "start_sec": 67.39999999999999,
    "end_sec": 69.2,
    "text": "比如说溜的鸡 跑山鸡"
  },
  {
    "start": "00:01:09.200",
    "end": "00:01:11.640",
    "start_sec": 69.2,
    "end_sec": 71.64,
    "text": "做这个菜就不太适合"
  },
  {
    "start": "00:01:11.640",
    "end": "00:01:13.760",
    "start_sec": 71.64,
    "end_sec": 73.75999999999999,
    "text": "可能做的菜还得上高爱锅"
  },
  {
    "start": "00:01:13.760",
    "end": "00:01:16.280",
    "start_sec": 73.75999999999999,
    "end_sec": 76.28,
    "text": "对 咱们先把配菜切一下"
  },
  {
    "start": "00:01:16.280",
    "end": "00:01:17.120",
    "start_sec": 76.28,
    "end_sec": 77.12,
    "text": "切一下"
  },
  {
    "start": "00:01:17.120",
    "end": "00:01:19.560",
    "start_sec": 77.12,
    "end_sec": 79.56,
    "text": "山东炒鸡有一个生口流的"
  },
  {
    "start": "00:01:19.560",
    "end": "00:01:21.120",
    "start_sec": 79.56,
    "end_sec": 81.12,
    "text": "第一句就是炒鸡不放姜"
  },
  {
    "start": "00:01:21.120",
    "end": "00:01:22.240",
    "start_sec": 81.12,
    "end_sec": 82.24,
    "text": "神仙也炒不香"
  },
  {
    "start": "00:01:22.240",
    "end": "00:01:23.480",
    "start_sec": 82.24,
    "end_sec": 83.47999999999999,
    "text": "姜比较多一些"
  },
  {
    "start": "00:01:24.360",
    "end": "00:01:26.400",
    "start_sec": 84.36,
    "end_sec": 86.4,
    "text": "蒜我们轻轻一拍就可以了"
  },
  {
    "start": "00:01:28.480",
    "end": "00:01:32.480",
    "start_sec": 88.48,
    "end_sec": 92.48,
    "text": "其实姜的味道去腥的效果还是特别突出"
  },
  {
    "start": "00:01:32.480",
    "end": "00:01:34.400",
    "start_sec": 92.48,
    "end_sec": 94.4,
    "text": "除了去腥以外"
  },
  {
    "start": "00:01:34.400",
    "end": "00:01:37.760",
    "start_sec": 94.4,
    "end_sec": 97.76,
    "text": "它本身的味还是持久性比较强"
  },
  {
    "start": "00:01:37.760",
    "end": "00:01:40.800",
    "start_sec": 97.76,
    "end_sec": 100.80000000000001,
    "text": "像好多菜其实都离不开姜"
  },
  {
    "start": "00:01:40.800",
    "end": "00:01:42.120",
    "start_sec": 100.80000000000001,
    "end_sec": 102.12,
    "text": "螺丝椒切滚刀是吧"
  },
  {
    "start": "00:01:42.120",
    "end": "00:01:42.680",
    "start_sec": 102.12,
    "end_sec": 102.68,
    "text": "对"
  },
  {
    "start": "00:01:43.160",
    "end": "00:01:45.080",
    "start_sec": 103.16,
    "end_sec": 105.08000000000001,
    "text": "亮子 问你一问题"
  },
  {
    "start": "00:01:45.080",
    "end": "00:01:46.800",
    "start_sec": 105.08000000000001,
    "end_sec": 106.80000000000001,
    "text": "我给你请示请示"
  },
  {
    "start": "00:01:46.800",
    "end": "00:01:48.120",
    "start_sec": 106.80000000000001,
    "end_sec": 108.12,
    "text": "学一学"
  },
  {
    "start": "00:01:48.120",
    "end": "00:01:49.160",
    "start_sec": 108.12,
    "end_sec": 109.16,
    "text": "请教请教"
  },
  {
    "start": "00:01:49.160",
    "end": "00:01:50.680",
    "start_sec": 109.16,
    "end_sec": 110.68,
    "text": "你比如说它这姜"
  },
  {
    "start": "00:01:50.680",
    "end": "00:01:53.160",
    "start_sec": 110.68,
    "end_sec": 113.16,
    "text": "脱皮跟不脱皮用这鸡"
  },
  {
    "start": "00:01:53.160",
    "end": "00:01:55.840",
    "start_sec": 113.16,
    "end_sec": 115.84,
    "text": "有什么不一样的吗"
  },
  {
    "start": "00:01:56.400",
    "end": "00:02:01.040",
    "start_sec": 116.4,
    "end_sec": 121.04,
    "text": "它皮要是削了皮切的形状好点"
  },
  {
    "start": "00:02:01.040",
    "end": "00:02:02.800",
    "start_sec": 121.04,
    "end_sec": 122.8,
    "text": "可能有的喜欢爱吃姜"
  },
  {
    "start": "00:02:02.800",
    "end": "00:02:03.880",
    "start_sec": 122.8,
    "end_sec": 123.88000000000001,
    "text": "它就直接吃了"
  },
  {
    "start": "00:02:03.880",
    "end": "00:02:06.680",
    "start_sec": 123.88000000000001,
    "end_sec": 126.68,
    "text": "其实你说的就不对"
  },
  {
    "start": "00:02:06.680",
    "end": "00:02:07.680",
    "start_sec": 126.68,
    "end_sec": 127.68,
    "text": "你知道吧"
  },
  {
    "start": "00:02:07.680",
    "end": "00:02:10.600",
    "start_sec": 127.68,
    "end_sec": 130.6,
    "text": "其实你看这鸡是热性的"
  },
  {
    "start": "00:02:10.600",
    "end": "00:02:11.520",
    "start_sec": 130.6,
    "end_sec": 131.52,
    "text": "是不是猴哥"
  },
  {
    "start": "00:02:11.520",
    "end": "00:02:12.720",
    "start_sec": 131.52,
    "end_sec": 132.72,
    "text": "它属于热性的"
  },
  {
    "start": "00:02:12.720",
    "end": "00:02:16.160",
    "start_sec": 132.72,
    "end_sec": 136.16,
    "text": "你看皮不打皮"
  },
  {
    "start": "00:02:16.160",
    "end": "00:02:18.880",
    "start_sec": 136.16,
    "end_sec": 138.88,
    "text": "它属于发凉性的了"
  },
  {
    "start": "00:02:18.880",
    "end": "00:02:20.000",
    "start_sec": 138.88,
    "end_sec": 140.0,
    "text": "你要打了皮"
  },
  {
    "start": "00:02:20.000",
    "end": "00:02:21.840",
    "start_sec": 140.0,
    "end_sec": 141.84,
    "text": "它就是翻热的走"
  },
  {
    "start": "00:02:21.840",
    "end": "00:02:23.680",
    "start_sec": 141.84,
    "end_sec": 143.68,
    "text": "所以说姜的用法不一样"
  },
  {
    "start": "00:02:23.680",
    "end": "00:02:25.320",
    "start_sec": 143.68,
    "end_sec": 145.32,
    "text": "它这么配是有道理的"
  },
  {
    "start": "00:02:25.320",
    "end": "00:02:28.760",
    "start_sec": 145.32,
    "end_sec": 148.76,
    "text": "其实我跟小王认识"
  },
  {
    "start": "00:02:28.760",
    "end": "00:02:32.600",
    "start_sec": 148.76,
    "end_sec": 152.6,
    "text": "是因为我的店里想上一款山东炒鸡"
  },
  {
    "start": "00:02:32.600",
    "end": "00:02:34.640",
    "start_sec": 152.6,
    "end_sec": 154.64,
    "text": "因为山东炒鸡现在比较流行"
  },
  {
    "start": "00:02:34.640",
    "end": "00:02:40.160",
    "start_sec": 154.64,
    "end_sec": 160.16,
    "text": "正好我一个好朋友在山东做炒鸡的酱"
  },
  {
    "start": "00:02:40.160",
    "end": "00:02:42.320",
    "start_sec": 160.16,
    "end_sec": 162.32,
    "text": "所以我就去他们厂子"
  },
  {
    "start": "00:02:42.320",
    "end": "00:02:44.160",
    "start_sec": 162.32,
    "end_sec": 164.16,
    "text": "去实地看了一下"
  },
  {
    "start": "00:02:44.160",
    "end": "00:02:48.040",
    "start_sec": 164.16,
    "end_sec": 168.04,
    "text": "而且我们还真在一起"
  },
  {
    "start": "00:02:48.040",
    "end": "00:02:50.560",
    "start_sec": 168.04,
    "end_sec": 170.56,
    "text": "研发了大概得有半天"
  },
  {
    "start": "00:02:50.560",
    "end": "00:02:52.240",
    "start_sec": 170.56,
    "end_sec": 172.24,
    "text": "我个人认为适当的补充"
  },
  {
    "start": "00:02:52.240",
    "end": "00:02:52.880",
    "start_sec": 172.24,
    "end_sec": 172.88,
    "text": "是吧"
  },
  {
    "start": "00:02:52.880",
    "end": "00:02:55.320",
    "start_sec": 172.88,
    "end_sec": 175.32,
    "text": "那么今天小王王厨师长"
  },
  {
    "start": "00:02:55.320",
    "end": "00:02:56.520",
    "start_sec": 175.32,
    "end_sec": 176.51999999999998,
    "text": "快过年了"
  },
  {
    "start": "00:02:56.520",
    "end": "00:02:58.400",
    "start_sec": 176.51999999999998,
    "end_sec": 178.4,
    "text": "给大家做一款"
  },
  {
    "start": "00:02:58.400",
    "end": "00:03:01.720",
    "start_sec": 178.4,
    "end_sec": 181.72,
    "text": "想大家在节日的饭圈上"
  },
  {
    "start": "00:03:01.720",
    "end": "00:03:06.680",
    "start_sec": 181.72,
    "end_sec": 186.68,
    "text": "能增加一道平常不吃的美食"
  },
  {
    "start": "00:03:06.680",
    "end": "00:03:10.240",
    "start_sec": 186.68,
    "end_sec": 190.24,
    "text": "可能平常大家还真不知道怎么做"
  },
  {
    "start": "00:03:10.240",
    "end": "00:03:12.200",
    "start_sec": 190.24,
    "end_sec": 192.2,
    "text": "在饭店可能吃的比较多"
  },
  {
    "start": "00:03:12.200",
    "end": "00:03:13.840",
    "start_sec": 192.2,
    "end_sec": 193.84,
    "text": "这个姜给它榨干"
  },
  {
    "start": "00:03:13.840",
    "end": "00:03:14.640",
    "start_sec": 193.84,
    "end_sec": 194.64,
    "text": "对 要榨干"
  },
  {
    "start": "00:03:14.640",
    "end": "00:03:17.760",
    "start_sec": 194.64,
    "end_sec": 197.76,
    "text": "榨到现在有点轻微的"
  },
  {
    "start": "00:03:17.760",
    "end": "00:03:18.720",
    "start_sec": 197.76,
    "end_sec": 198.72,
    "text": "就是金黄的状态"
  },
  {
    "start": "00:03:18.720",
    "end": "00:03:19.960",
    "start_sec": 198.72,
    "end_sec": 199.96,
    "text": "这是边缘金黄了"
  },
  {
    "start": "00:03:19.960",
    "end": "00:03:22.120",
    "start_sec": 199.96,
    "end_sec": 202.12,
    "text": "这其实现在就刚好"
  },
  {
    "start": "00:03:22.120",
    "end": "00:03:24.600",
    "start_sec": 202.12,
    "end_sec": 204.6,
    "text": "把咱们的香辛料下去去爆香"
  },
  {
    "start": "00:03:24.600",
    "end": "00:03:26.600",
    "start_sec": 204.6,
    "end_sec": 206.6,
    "text": "这一关一下"
  },
  {
    "start": "00:03:26.600",
    "end": "00:03:27.840",
    "start_sec": 206.6,
    "end_sec": 207.84,
    "text": "这时候火要小"
  },
  {
    "start": "00:03:27.840",
    "end": "00:03:30.280",
    "start_sec": 207.84,
    "end_sec": 210.28,
    "text": "把温度降下来"
  },
  {
    "start": "00:03:30.280",
    "end": "00:03:31.360",
    "start_sec": 210.28,
    "end_sec": 211.36,
    "text": "这时候我们就看着就好了"
  },
  {
    "start": "00:03:31.360",
    "end": "00:03:32.000",
    "start_sec": 211.36,
    "end_sec": 212.0,
    "text": "关火了"
  },
  {
    "start": "00:03:32.000",
    "end": "00:03:33.680",
    "start_sec": 212.0,
    "end_sec": 213.68,
    "text": "对 以辣椒为主"
  },
  {
    "start": "00:03:33.680",
    "end": "00:03:34.760",
    "start_sec": 213.68,
    "end_sec": 214.76,
    "text": "就是辣椒不糊"
  },
  {
    "start": "00:03:34.760",
    "end": "00:03:36.480",
    "start_sec": 214.76,
    "end_sec": 216.48000000000002,
    "text": "其他的就糊不了"
  },
  {
    "start": "00:03:36.480",
    "end": "00:03:38.200",
    "start_sec": 216.48000000000002,
    "end_sec": 218.20000000000002,
    "text": "辣椒变色了"
  },
  {
    "start": "00:03:38.200",
    "end": "00:03:39.720",
    "start_sec": 218.20000000000002,
    "end_sec": 219.72,
    "text": "咱们就把鸡肉倒进去"
  },
  {
    "start": "00:03:46.040",
    "end": "00:03:48.040",
    "start_sec": 226.04000000000002,
    "end_sec": 228.04000000000002,
    "text": "下去之后就跟别的炒鸡也一样"
  },
  {
    "start": "00:03:48.040",
    "end": "00:03:50.200",
    "start_sec": 228.04000000000002,
    "end_sec": 230.20000000000002,
    "text": "就是先不要动它"
  },
  {
    "start": "00:03:50.200",
    "end": "00:03:52.000",
    "start_sec": 230.20000000000002,
    "end_sec": 232.0,
    "text": "也是让它稍微的定理型"
  },
  {
    "start": "00:03:52.000",
    "end": "00:03:52.760",
    "start_sec": 232.0,
    "end_sec": 232.76,
    "text": "就是再翻炒"
  },
  {
    "start": "00:03:52.760",
    "end": "00:03:55.200",
    "start_sec": 232.76,
    "end_sec": 235.2,
    "text": "要不然这鸡肉形状不好炒出来"
  },
  {
    "start": "00:03:56.720",
    "end": "00:03:58.600",
    "start_sec": 236.72,
    "end_sec": 238.6,
    "text": "其实有些人"
  },
  {
    "start": "00:03:58.600",
    "end": "00:04:02.040",
    "start_sec": 238.6,
    "end_sec": 242.04,
    "text": "比如说是先煸鸡后搁料"
  },
  {
    "start": "00:04:02.040",
    "end": "00:04:04.800",
    "start_sec": 242.04,
    "end_sec": 244.8,
    "text": "其实不如先煸料好"
  },
  {
    "start": "00:04:04.800",
    "end": "00:04:05.520",
    "start_sec": 244.8,
    "end_sec": 245.52,
    "text": "先煸料"
  },
  {
    "start": "00:04:05.520",
    "end": "00:04:05.960",
    "start_sec": 245.52,
    "end_sec": 245.96,
    "text": "对"
  },
  {
    "start": "00:04:05.960",
    "end": "00:04:06.960",
    "start_sec": 245.96,
    "end_sec": 246.96,
    "text": "激发之外"
  },
  {
    "start": "00:04:06.960",
    "end": "00:04:08.400",
    "start_sec": 246.96,
    "end_sec": 248.4,
    "text": "它今天就是这么"
  },
  {
    "start": "00:04:08.400",
    "end": "00:04:10.840",
    "start_sec": 248.4,
    "end_sec": 250.84,
    "text": "高的油温就属于叫激发"
  },
  {
    "start": "00:04:10.840",
    "end": "00:04:13.200",
    "start_sec": 250.84,
    "end_sec": 253.2,
    "text": "这是吃辣瞬间的就一下"
  },
  {
    "start": "00:04:13.200",
    "end": "00:04:14.480",
    "start_sec": 253.2,
    "end_sec": 254.48,
    "text": "对的"
  },
  {
    "start": "00:04:14.480",
    "end": "00:04:18.400",
    "start_sec": 254.48,
    "end_sec": 258.4,
    "text": "它对香味的提升效果非常好"
  },
  {
    "start": "00:04:19.400",
    "end": "00:04:21.400",
    "start_sec": 259.4,
    "end_sec": 261.4,
    "text": "像山东炒鸡"
  },
  {
    "start": "00:04:21.400",
    "end": "00:04:24.400",
    "start_sec": 261.4,
    "end_sec": 264.4,
    "text": "是不是各个地域的文派"
  },
  {
    "start": "00:04:24.400",
    "end": "00:04:26.400",
    "start_sec": 264.4,
    "end_sec": 266.4,
    "text": "和炒制的方法和味道"
  },
  {
    "start": "00:04:26.400",
    "end": "00:04:28.400",
    "start_sec": 266.4,
    "end_sec": 268.4,
    "text": "也不是特别一样"
  },
  {
    "start": "00:04:28.400",
    "end": "00:04:29.400",
    "start_sec": 268.4,
    "end_sec": 269.4,
    "text": "对 严格来说"
  },
  {
    "start": "00:04:29.400",
    "end": "00:04:31.400",
    "start_sec": 269.4,
    "end_sec": 271.4,
    "text": "到山东地区之后"
  },
  {
    "start": "00:04:31.400",
    "end": "00:04:34.400",
    "start_sec": 271.4,
    "end_sec": 274.4,
    "text": "每个地级市都有自己特色的炒鸡"
  },
  {
    "start": "00:04:34.400",
    "end": "00:04:36.400",
    "start_sec": 274.4,
    "end_sec": 276.4,
    "text": "咱们知道的比较多的是"
  },
  {
    "start": "00:04:36.400",
    "end": "00:04:37.400",
    "start_sec": 276.4,
    "end_sec": 277.4,
    "text": "像林一炒鸡"
  },
  {
    "start": "00:04:37.400",
    "end": "00:04:38.400",
    "start_sec": 277.4,
    "end_sec": 278.4,
    "text": "很辣"
  },
  {
    "start": "00:04:38.400",
    "end": "00:04:39.400",
    "start_sec": 278.4,
    "end_sec": 279.4,
    "text": "对 很辣"
  },
  {
    "start": "00:04:39.400",
    "end": "00:04:40.400",
    "start_sec": 279.4,
    "end_sec": 280.4,
    "text": "林一炒鸡其实以前的时候"
  },
  {
    "start": "00:04:40.400",
    "end": "00:04:41.400",
    "start_sec": 280.4,
    "end_sec": 281.4,
    "text": "还不怎么辣"
  },
  {
    "start": "00:04:41.400",
    "end": "00:04:43.400",
    "start_sec": 281.4,
    "end_sec": 283.4,
    "text": "现在的辣度是什么呢"
  },
  {
    "start": "00:04:43.400",
    "end": "00:04:45.400",
    "start_sec": 283.4,
    "end_sec": 285.4,
    "text": "最早它也是用咱们这种螺丝椒"
  },
  {
    "start": "00:04:45.400",
    "end": "00:04:46.400",
    "start_sec": 285.4,
    "end_sec": 286.4,
    "text": "现在改成了薄皮辣椒"
  },
  {
    "start": "00:04:46.400",
    "end": "00:04:49.400",
    "start_sec": 286.4,
    "end_sec": 289.4,
    "text": "它是根据早装辣子鸡改变过来的"
  },
  {
    "start": "00:04:49.400",
    "end": "00:04:52.400",
    "start_sec": 289.4,
    "end_sec": 292.4,
    "text": "然后再跟早装辣子鸡做了一个结合"
  },
  {
    "start": "00:04:52.400",
    "end": "00:04:54.400",
    "start_sec": 292.4,
    "end_sec": 294.4,
    "text": "然后比较"
  },
  {
    "start": "00:04:54.400",
    "end": "00:04:55.400",
    "start_sec": 294.4,
    "end_sec": 295.4,
    "text": "可以比较说的比较骄傲的就是"
  },
  {
    "start": "00:04:55.400",
    "end": "00:04:57.400",
    "start_sec": 295.4,
    "end_sec": 297.4,
    "text": "泰安把山东炒鸡"
  },
  {
    "start": "00:04:57.400",
    "end": "00:05:00.400",
    "start_sec": 297.4,
    "end_sec": 300.4,
    "text": "做了飞鱼的那个认证了"
  },
  {
    "start": "00:05:00.400",
    "end": "00:05:03.400",
    "start_sec": 300.4,
    "end_sec": 303.4,
    "text": "飞鱼的认证现在是在山东泰安的心态"
  },
  {
    "start": "00:05:03.400",
    "end": "00:05:05.400",
    "start_sec": 303.4,
    "end_sec": 305.4,
    "text": "然后我们要炒到什么程度呢"
  },
  {
    "start": "00:05:05.400",
    "end": "00:05:06.400",
    "start_sec": 305.4,
    "end_sec": 306.4,
    "text": "就炒到这个鸡肉"
  },
  {
    "start": "00:05:06.400",
    "end": "00:05:08.400",
    "start_sec": 306.4,
    "end_sec": 308.4,
    "text": "基本上没有明显水分了"
  },
  {
    "start": "00:05:08.400",
    "end": "00:05:09.400",
    "start_sec": 308.4,
    "end_sec": 309.4,
    "text": "我们现在的油是清亮的"
  },
  {
    "start": "00:05:09.400",
    "end": "00:05:11.400",
    "start_sec": 309.4,
    "end_sec": 311.4,
    "text": "还有点浑浊"
  },
  {
    "start": "00:05:11.400",
    "end": "00:05:12.400",
    "start_sec": 311.4,
    "end_sec": 312.4,
    "text": "对 现在还有点浑浊"
  },
  {
    "start": "00:05:12.400",
    "end": "00:05:13.400",
    "start_sec": 312.4,
    "end_sec": 313.4,
    "text": "要炒到这个油"
  },
  {
    "start": "00:05:13.400",
    "end": "00:05:14.400",
    "start_sec": 313.4,
    "end_sec": 314.4,
    "text": "水分炒不见"
  },
  {
    "start": "00:05:14.400",
    "end": "00:05:18.400",
    "start_sec": 314.4,
    "end_sec": 318.4,
    "text": "王厨给大家提供了一个非常好的"
  },
  {
    "start": "00:05:18.400",
    "end": "00:05:20.400",
    "start_sec": 318.4,
    "end_sec": 320.4,
    "text": "这个鉴别炒鸡到什么程度"
  },
  {
    "start": "00:05:20.400",
    "end": "00:05:22.400",
    "start_sec": 320.4,
    "end_sec": 322.4,
    "text": "炒合适的方法"
  },
  {
    "start": "00:05:22.400",
    "end": "00:05:24.400",
    "start_sec": 322.4,
    "end_sec": 324.4,
    "text": "就是这油清亮了不浑浊了"
  },
  {
    "start": "00:05:24.400",
    "end": "00:05:28.400",
    "start_sec": 324.4,
    "end_sec": 328.4,
    "text": "不是 其实这个清亮不清亮在哪呢"
  },
  {
    "start": "00:05:28.400",
    "end": "00:05:30.400",
    "start_sec": 328.4,
    "end_sec": 330.4,
    "text": "现在这油里还有水"
  },
  {
    "start": "00:05:30.400",
    "end": "00:05:31.400",
    "start_sec": 330.4,
    "end_sec": 331.4,
    "text": "有水它就浑"
  },
  {
    "start": "00:05:31.400",
    "end": "00:05:32.400",
    "start_sec": 331.4,
    "end_sec": 332.4,
    "text": "没错"
  },
  {
    "start": "00:05:32.400",
    "end": "00:05:35.400",
    "start_sec": 332.4,
    "end_sec": 335.4,
    "text": "水都蒸发了它就清亮了"
  },
  {
    "start": "00:05:35.400",
    "end": "00:05:36.400",
    "start_sec": 335.4,
    "end_sec": 336.4,
    "text": "来 拌点油"
  },
  {
    "start": "00:05:36.400",
    "end": "00:05:39.400",
    "start_sec": 336.4,
    "end_sec": 339.4,
    "text": "看 就很清亮了 不浑浊了"
  },
  {
    "start": "00:05:39.400",
    "end": "00:05:40.400",
    "start_sec": 339.4,
    "end_sec": 340.4,
    "text": "好"
  },
  {
    "start": "00:05:40.400",
    "end": "00:05:42.400",
    "start_sec": 340.4,
    "end_sec": 342.4,
    "text": "这时候我们把火调小点"
  },
  {
    "start": "00:05:42.400",
    "end": "00:05:45.400",
    "start_sec": 342.4,
    "end_sec": 345.4,
    "text": "把我们的盐料下茶"
  },
  {
    "start": "00:05:45.400",
    "end": "00:05:46.400",
    "start_sec": 345.4,
    "end_sec": 346.4,
    "text": "把我们的黄豆酱下去"
  },
  {
    "start": "00:05:46.400",
    "end": "00:05:47.400",
    "start_sec": 346.4,
    "end_sec": 347.4,
    "text": "黄豆酱80克"
  },
  {
    "start": "00:05:47.400",
    "end": "00:05:50.400",
    "start_sec": 347.4,
    "end_sec": 350.4,
    "text": "我们的甜面酱放了40克"
  },
  {
    "start": "00:05:50.400",
    "end": "00:05:53.400",
    "start_sec": 350.4,
    "end_sec": 353.4,
    "text": "然后我们的蚝油20克"
  },
  {
    "start": "00:05:53.400",
    "end": "00:05:56.400",
    "start_sec": 353.4,
    "end_sec": 356.4,
    "text": "黄豆酱油40克"
  },
  {
    "start": "00:05:58.400",
    "end": "00:05:59.400",
    "start_sec": 358.4,
    "end_sec": 359.4,
    "text": "把这个酱炒均匀"
  },
  {
    "start": "00:05:59.400",
    "end": "00:06:01.400",
    "start_sec": 359.4,
    "end_sec": 361.4,
    "text": "让它均匀裹在鸡上"
  },
  {
    "start": "00:06:02.400",
    "end": "00:06:04.400",
    "start_sec": 362.4,
    "end_sec": 364.4,
    "text": "酱熬一下稍微"
  },
  {
    "start": "00:06:04.400",
    "end": "00:06:07.400",
    "start_sec": 364.4,
    "end_sec": 367.4,
    "text": "要不然有一股生酱味"
  },
  {
    "start": "00:06:08.400",
    "end": "00:06:10.400",
    "start_sec": 368.4,
    "end_sec": 370.4,
    "text": "把酱均匀的能裹在鸡肉上"
  },
  {
    "start": "00:06:10.400",
    "end": "00:06:11.400",
    "start_sec": 370.4,
    "end_sec": 371.4,
    "text": "这时候就可以加水了"
  },
  {
    "start": "00:06:11.400",
    "end": "00:06:13.400",
    "start_sec": 371.4,
    "end_sec": 373.4,
    "text": "尽量加开水"
  },
  {
    "start": "00:06:15.400",
    "end": "00:06:18.400",
    "start_sec": 375.4,
    "end_sec": 378.4,
    "text": "让我们的水略微的没过鸡肉"
  },
  {
    "start": "00:06:20.400",
    "end": "00:06:21.400",
    "start_sec": 380.4,
    "end_sec": 381.4,
    "text": "水开之后"
  },
  {
    "start": "00:06:21.400",
    "end": "00:06:24.400",
    "start_sec": 381.4,
    "end_sec": 384.4,
    "text": "我们为了让它更好的入味和成熟"
  },
  {
    "start": "00:06:24.400",
    "end": "00:06:26.400",
    "start_sec": 384.4,
    "end_sec": 386.4,
    "text": "可以把锅盖这时候就盖上一会"
  },
  {
    "start": "00:06:26.400",
    "end": "00:06:27.400",
    "start_sec": 386.4,
    "end_sec": 387.4,
    "text": "盖个十来分钟"
  },
  {
    "start": "00:06:29.400",
    "end": "00:06:31.400",
    "start_sec": 389.4,
    "end_sec": 391.4,
    "text": "火就是一直大火是吧"
  },
  {
    "start": "00:06:31.400",
    "end": "00:06:33.400",
    "start_sec": 391.4,
    "end_sec": 393.4,
    "text": "这时候盖上盖之后再开了"
  },
  {
    "start": "00:06:33.400",
    "end": "00:06:35.400",
    "start_sec": 393.4,
    "end_sec": 395.4,
    "text": "等冒气了咱就可以调成中火了"
  },
  {
    "start": "00:06:35.400",
    "end": "00:06:37.400",
    "start_sec": 395.4,
    "end_sec": 397.4,
    "text": "因为这会火大火小"
  },
  {
    "start": "00:06:37.400",
    "end": "00:06:39.400",
    "start_sec": 397.4,
    "end_sec": 399.4,
    "text": "已经不影响它的温度了"
  },
  {
    "start": "00:06:39.400",
    "end": "00:06:43.400",
    "start_sec": 399.4,
    "end_sec": 403.4,
    "text": "它这四种酱其实包括酱油都是"
  },
  {
    "start": "00:06:43.400",
    "end": "00:06:46.400",
    "start_sec": 403.4,
    "end_sec": 406.4,
    "text": "你看它不是说像那种勾兑的酱油"
  },
  {
    "start": "00:06:46.400",
    "end": "00:06:48.400",
    "start_sec": 406.4,
    "end_sec": 408.4,
    "text": "都是酿造的这种东西"
  },
  {
    "start": "00:06:48.400",
    "end": "00:06:50.400",
    "start_sec": 408.4,
    "end_sec": 410.4,
    "text": "所以说都是为了提鲜"
  },
  {
    "start": "00:06:50.400",
    "end": "00:06:53.400",
    "start_sec": 410.4,
    "end_sec": 413.4,
    "text": "一个提色提鲜然后提香"
  },
  {
    "start": "00:06:53.400",
    "end": "00:06:54.400",
    "start_sec": 413.4,
    "end_sec": 414.4,
    "text": "冰糖老抽"
  },
  {
    "start": "00:06:59.400",
    "end": "00:07:02.400",
    "start_sec": 419.4,
    "end_sec": 422.4,
    "text": "亮亮你把这个料包拿来一下"
  },
  {
    "start": "00:07:05.400",
    "end": "00:07:06.400",
    "start_sec": 425.4,
    "end_sec": 426.4,
    "text": "清蒸的"
  },
  {
    "start": "00:07:06.400",
    "end": "00:07:07.400",
    "start_sec": 426.4,
    "end_sec": 427.4,
    "text": "对大家看一下"
  },
  {
    "start": "00:07:07.400",
    "end": "00:07:09.400",
    "start_sec": 427.4,
    "end_sec": 429.4,
    "text": "这个料包就是咱刚才搁的东西是吧"
  },
  {
    "start": "00:07:09.400",
    "end": "00:07:10.400",
    "start_sec": 429.4,
    "end_sec": 430.4,
    "text": "差不多吧"
  },
  {
    "start": "00:07:10.400",
    "end": "00:07:12.400",
    "start_sec": 430.4,
    "end_sec": 432.4,
    "text": "因为这个是我们工厂做的"
  },
  {
    "start": "00:07:12.400",
    "end": "00:07:15.400",
    "start_sec": 432.4,
    "end_sec": 435.4,
    "text": "刚才给大家的配比是家用的"
  },
  {
    "start": "00:07:15.400",
    "end": "00:07:18.400",
    "start_sec": 435.4,
    "end_sec": 438.4,
    "text": "如果大家为了更方便"
  },
  {
    "start": "00:07:19.400",
    "end": "00:07:21.400",
    "start_sec": 439.4,
    "end_sec": 441.4,
    "text": "回去买完鸡以后炒完了"
  },
  {
    "start": "00:07:21.400",
    "end": "00:07:22.400",
    "start_sec": 441.4,
    "end_sec": 442.4,
    "text": "直接把料包加上"
  },
  {
    "start": "00:07:22.400",
    "end": "00:07:23.400",
    "start_sec": 442.4,
    "end_sec": 443.4,
    "text": "上面都有说明和比例"
  },
  {
    "start": "00:07:24.400",
    "end": "00:07:27.400",
    "start_sec": 444.4,
    "end_sec": 447.4,
    "text": "这是我们再简单的补一下味道"
  },
  {
    "start": "00:07:27.400",
    "end": "00:07:29.400",
    "start_sec": 447.4,
    "end_sec": 449.4,
    "text": "补一勺的味精"
  },
  {
    "start": "00:07:29.400",
    "end": "00:07:31.400",
    "start_sec": 449.4,
    "end_sec": 451.4,
    "text": "补一勺的鸡粉"
  },
  {
    "start": "00:07:31.400",
    "end": "00:07:32.400",
    "start_sec": 451.4,
    "end_sec": 452.4,
    "text": "提半勺的白糖"
  },
  {
    "start": "00:07:34.400",
    "end": "00:07:36.400",
    "start_sec": 454.4,
    "end_sec": 456.4,
    "text": "其实只要不糊就可以多收一口"
  },
  {
    "start": "00:07:37.400",
    "end": "00:07:42.400",
    "start_sec": 457.4,
    "end_sec": 462.4,
    "text": "炒到汁已经收的很少了"
  },
  {
    "start": "00:07:42.400",
    "end": "00:07:43.400",
    "start_sec": 462.4,
    "end_sec": 463.4,
    "text": "很粘稠了"
  },
  {
    "start": "00:07:43.400",
    "end": "00:07:44.400",
    "start_sec": 463.4,
    "end_sec": 464.4,
    "text": "比较粘稠了"
  },
  {
    "start": "00:07:44.400",
    "end": "00:07:45.400",
    "start_sec": 464.4,
    "end_sec": 465.4,
    "text": "小泡比较多了"
  },
  {
    "start": "00:07:45.400",
    "end": "00:07:48.400",
    "start_sec": 465.4,
    "end_sec": 468.4,
    "text": "这时候把我们准备的生鲜放进去"
  },
  {
    "start": "00:07:48.400",
    "end": "00:07:50.400",
    "start_sec": 468.4,
    "end_sec": 470.4,
    "text": "螺丝椒美人椒"
  },
  {
    "start": "00:07:50.400",
    "end": "00:07:52.400",
    "start_sec": 470.4,
    "end_sec": 472.4,
    "text": "红美人椒完了"
  },
  {
    "start": "00:07:52.400",
    "end": "00:07:54.400",
    "start_sec": 472.4,
    "end_sec": 474.4,
    "text": "葱段还有蒜是吧"
  },
  {
    "start": "00:07:55.400",
    "end": "00:07:57.400",
    "start_sec": 475.4,
    "end_sec": 477.4,
    "text": "然后我们基本上炒的"
  },
  {
    "start": "00:07:57.400",
    "end": "00:07:59.400",
    "start_sec": 477.4,
    "end_sec": 479.4,
    "text": "不用特别断生"
  },
  {
    "start": "00:07:59.400",
    "end": "00:08:01.400",
    "start_sec": 479.4,
    "end_sec": 481.4,
    "text": "它不凉就可以了"
  },
  {
    "start": "00:08:01.400",
    "end": "00:08:04.400",
    "start_sec": 481.4,
    "end_sec": 484.4,
    "text": "正好这就是我哥们儿好朋友"
  },
  {
    "start": "00:08:04.400",
    "end": "00:08:07.400",
    "start_sec": 484.4,
    "end_sec": 487.4,
    "text": "也是200年的创始人田总"
  },
  {
    "start": "00:08:08.400",
    "end": "00:08:09.400",
    "start_sec": 488.4,
    "end_sec": 489.4,
    "text": "大师"
  },
  {
    "start": "00:08:09.400",
    "end": "00:08:12.400",
    "start_sec": 489.4,
    "end_sec": 492.4,
    "text": "炒到我们现在这些蒜和辣椒都"
  },
  {
    "start": "00:08:12.400",
    "end": "00:08:13.400",
    "start_sec": 492.4,
    "end_sec": 493.4,
    "text": "关火了"
  },
  {
    "start": "00:08:13.400",
    "end": "00:08:14.400",
    "start_sec": 493.4,
    "end_sec": 494.4,
    "text": "热透了就可以了"
  },
  {
    "start": "00:08:14.400",
    "end": "00:08:15.400",
    "start_sec": 494.4,
    "end_sec": 495.4,
    "text": "出锅"
  },
  {
    "start": "00:08:15.400",
    "end": "00:08:16.400",
    "start_sec": 495.4,
    "end_sec": 496.4,
    "text": "真漂亮"
  },
  {
    "start": "00:08:31.400",
    "end": "00:08:32.400",
    "start_sec": 511.4,
    "end_sec": 512.4,
    "text": "加一块肉多了"
  },
  {
    "start": "00:08:33.400",
    "end": "00:08:35.400",
    "start_sec": 513.4,
    "end_sec": 515.4,
    "text": "蘸点汁去蘸汁"
  },
  {
    "start": "00:08:37.400",
    "end": "00:08:40.400",
    "start_sec": 517.4,
    "end_sec": 520.4,
    "text": "吃把嘴也蘸上了都来不及说了"
  },
  {
    "start": "00:08:40.400",
    "end": "00:08:44.400",
    "start_sec": 520.4,
    "end_sec": 524.4,
    "text": "其实这种炒法属于生炒"
  },
  {
    "start": "00:08:44.400",
    "end": "00:08:46.400",
    "start_sec": 524.4,
    "end_sec": 526.4,
    "text": "但是肉质地甘香"
  },
  {
    "start": "00:08:46.400",
    "end": "00:08:48.400",
    "start_sec": 526.4,
    "end_sec": 528.4,
    "text": "因为它炒完吐完水之后"
  },
  {
    "start": "00:08:48.400",
    "end": "00:08:51.400",
    "start_sec": 528.4,
    "end_sec": 531.4,
    "text": "肉的紧实度口感特别好"
  },
  {
    "start": "00:08:52.400",
    "end": "00:08:54.400",
    "start_sec": 532.4,
    "end_sec": 534.4,
    "text": "而且最后经过这一闷"
  },
  {
    "start": "00:08:54.400",
    "end": "00:08:57.400",
    "start_sec": 534.4,
    "end_sec": 537.4,
    "text": "所有的酱料香料的味"
  },
  {
    "start": "00:08:57.400",
    "end": "00:09:00.400",
    "start_sec": 537.4,
    "end_sec": 540.4,
    "text": "还真都完全着服了"
  },
  {
    "start": "00:09:00.400",
    "end": "00:09:02.400",
    "start_sec": 540.4,
    "end_sec": 542.4,
    "text": "吃到这个基地情"
  },
  {
    "start": "00:09:02.400",
    "end": "00:09:03.400",
    "start_sec": 542.4,
    "end_sec": 543.4,
    "text": "你要不要从颜色"
  },
  {
    "start": "00:09:03.400",
    "end": "00:09:05.400",
    "start_sec": 543.4,
    "end_sec": 545.4,
    "text": "它颜色它从手法"
  },
  {
    "start": "00:09:05.400",
    "end": "00:09:08.400",
    "start_sec": 545.4,
    "end_sec": 548.4,
    "text": "从这四种料的这种搭配"
  },
  {
    "start": "00:09:08.400",
    "end": "00:09:09.400",
    "start_sec": 548.4,
    "end_sec": 549.4,
    "text": "它去平衡这些东西"
  },
  {
    "start": "00:09:09.400",
    "end": "00:09:12.400",
    "start_sec": 549.4,
    "end_sec": 552.4,
    "text": "包括酱油都是酿到的酱油"
  },
  {
    "start": "00:09:12.400",
    "end": "00:09:13.400",
    "start_sec": 552.4,
    "end_sec": 553.4,
    "text": "黄豆酱油"
  },
  {
    "start": "00:09:13.400",
    "end": "00:09:15.400",
    "start_sec": 553.4,
    "end_sec": 555.4,
    "text": "黄豆酱油它不会用什么"
  },
  {
    "start": "00:09:15.400",
    "end": "00:09:16.400",
    "start_sec": 555.4,
    "end_sec": 556.4,
    "text": "那种添加的酱油"
  },
  {
    "start": "00:09:16.400",
    "end": "00:09:17.400",
    "start_sec": 556.4,
    "end_sec": 557.4,
    "text": "就鲜大鲜"
  },
  {
    "start": "00:09:17.400",
    "end": "00:09:18.400",
    "start_sec": 557.4,
    "end_sec": 558.4,
    "text": "都对的酱油"
  },
  {
    "start": "00:09:18.400",
    "end": "00:09:20.400",
    "start_sec": 558.4,
    "end_sec": 560.4,
    "text": "如果说这个菜"
  },
  {
    "start": "00:09:20.400",
    "end": "00:09:22.400",
    "start_sec": 560.4,
    "end_sec": 562.4,
    "text": "如果说用其他酱油"
  },
  {
    "start": "00:09:22.400",
    "end": "00:09:23.400",
    "start_sec": 562.4,
    "end_sec": 563.4,
    "text": "我刚刚就坏了"
  },
  {
    "start": "00:09:23.400",
    "end": "00:09:24.400",
    "start_sec": 563.4,
    "end_sec": 564.4,
    "text": "田总"
  },
  {
    "start": "00:09:25.400",
    "end": "00:09:26.400",
    "start_sec": 565.4,
    "end_sec": 566.4,
    "text": "看到大家这吃"
  },
  {
    "start": "00:09:26.400",
    "end": "00:09:29.400",
    "start_sec": 566.4,
    "end_sec": 569.4,
    "text": "我就觉得大家都认可这个鸡"
  },
  {
    "start": "00:09:29.400",
    "end": "00:09:31.400",
    "start_sec": 569.4,
    "end_sec": 571.4,
    "text": "是好吃这俩字"
  },
  {
    "start": "00:09:31.400",
    "end": "00:09:33.400",
    "start_sec": 571.4,
    "end_sec": 573.4,
    "text": "但是我们今后对吧"
  },
  {
    "start": "00:09:33.400",
    "end": "00:09:35.400",
    "start_sec": 573.4,
    "end_sec": 575.4,
    "text": "就是不光是这口味"
  },
  {
    "start": "00:09:35.400",
    "end": "00:09:37.400",
    "start_sec": 575.4,
    "end_sec": 577.4,
    "text": "研发出更多的口味"
  },
  {
    "start": "00:09:37.400",
    "end": "00:09:38.400",
    "start_sec": 577.4,
    "end_sec": 578.4,
    "text": "明白明白"
  },
  {
    "start": "00:09:40.400",
    "end": "00:09:41.400",
    "start_sec": 580.4,
    "end_sec": 581.4,
    "text": "我瞧瞧这个旧饭"
  },
  {
    "start": "00:09:41.400",
    "end": "00:09:42.400",
    "start_sec": 581.4,
    "end_sec": 582.4,
    "text": "下酒也行"
  },
  {
    "start": "00:09:42.400",
    "end": "00:09:43.400",
    "start_sec": 582.4,
    "end_sec": 583.4,
    "text": "可以"
  },
  {
    "start": "00:09:43.400",
    "end": "00:09:45.400",
    "start_sec": 583.4,
    "end_sec": 585.4,
    "text": "它这个咸淡口也合适"
  },
  {
    "start": "00:09:45.400",
    "end": "00:09:47.400",
    "start_sec": 585.4,
    "end_sec": 587.4,
    "text": "酱香口也合适"
  },
  {
    "start": "00:09:47.400",
    "end": "00:09:48.400",
    "start_sec": 587.4,
    "end_sec": 588.4,
    "text": "这种麻辣的"
  },
  {
    "start": "00:09:48.400",
    "end": "00:09:50.400",
    "start_sec": 588.4,
    "end_sec": 590.4,
    "text": "微麻微辣的口也合适"
  },
  {
    "start": "00:09:50.400",
    "end": "00:09:52.400",
    "start_sec": 590.4,
    "end_sec": 592.4,
    "text": "传承经典老味道"
  },
  {
    "start": "00:09:52.400",
    "end": "00:09:54.400",
    "start_sec": 592.4,
    "end_sec": 594.4,
    "text": "一键三连少不了"
  },
  {
    "start": "00:09:54.400",
    "end": "00:09:55.400",
    "start_sec": 594.4,
    "end_sec": 595.4,
    "text": "小饭谷们"
  },
  {
    "start": "00:09:55.400",
    "end": "00:09:58.400",
    "start_sec": 595.4,
    "end_sec": 598.4,
    "text": "记得好好吃饭哟"
  }
]