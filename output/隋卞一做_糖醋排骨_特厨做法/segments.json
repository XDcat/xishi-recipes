    "end": "00:03:37.800",
    "start_sec": 215.88,
    "end_sec": 217.79999999999998,
    "text": "我已经调口一直调的特别准了"
  },
  {
    "start": "00:03:37.800",
    "end": "00:03:39.600",
    "start_sec": 217.79999999999998,
    "end_sec": 219.6,
    "text": "然后真不错"
  },
  {
    "start": "00:03:39.600",
    "end": "00:03:40.800",
    "start_sec": 219.6,
    "end_sec": 220.79999999999998,
    "text": "我再来一块吧"
  },
  {
    "start": "00:03:40.800",
    "end": "00:03:41.600",
    "start_sec": 220.79999999999998,
