    "end": "00:03:23.680",
    "start_sec": 202.88,
    "end_sec": 203.68,
    "text": "你说得对"
  },
  {
    "start": "00:03:23.680",
    "end": "00:03:25.680",
    "start_sec": 203.68,
    "end_sec": 205.68,
    "text": "还稍微有一点点焦香味"
  },
